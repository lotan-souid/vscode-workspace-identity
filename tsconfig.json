{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "Node16",
		"moduleResolution": "Node16",
		"rootDir": "src",
		"outDir": "out",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"sourceMap": true,
		"skipLibCheck": true
	},
	"include": ["src"]
}
